{
  "name": "remedy-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @remedy/server dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @remedy/db generate",
    "db:migrate": "pnpm --filter @remedy/db migrate",
    "db:seed": "pnpm --filter @remedy/server seed"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
