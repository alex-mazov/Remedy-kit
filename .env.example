# Copy to .env and adjust.
DATABASE_URL=postgres://remedy:remedy@localhost:5432/remedy
DATABASE_URL_TEST=postgres://remedy:remedy@localhost:5432/remedy_test
PORT=8787

# Public origin of the server. Passkeys are bound to its host name, so keep it
# stable (a changing tunnel URL means re-creating passkeys).
PUBLIC_URL=http://localhost:8787

# Signs cookies and OAuth state. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-32-plus

# Local development only: a fixed bearer token for the dev user (curl, MCP
# Inspector, Claude Code) without OAuth. Leave empty to disable.
# Ignored when NODE_ENV=production.
DEV_BEARER_TOKEN=dev-token-change-me
