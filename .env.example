# Copy to .env and adjust.
DATABASE_URL=postgres://remedy:remedy@localhost:5432/remedy
DATABASE_URL_TEST=postgres://remedy:remedy@localhost:5432/remedy_test
PORT=8787

# Stage 0 only: a fixed bearer token for the dev user, so MCP can be tried
# before real OAuth lands. Ignored when NODE_ENV=production.
DEV_BEARER_TOKEN=dev-token-change-me
